generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // .env 파일의 값 사용
}

// 게시글 유형
enum PostType {
  MyReview
  ProductQA
}

// 게시글 카테고리
enum PostCategory {
  SkinCare
  Makeup
  Hair
}

// 유저 테이블
model User {
  // 계정 정보
  id        String  @id @default(cuid())
  email     String  @unique
  password  String?
  firstName String
  lastName  String
  country   String?
  gender    String?
  age       String

  // Google 로그인 사용자 식별
  googleId String? @unique

  // 1:1 관계 - Terms 모델 연결
  terms Terms?

  // 1:1 관계 - Survey 모델 연결
  survey Survey?

  // 뷰티톡 게시글
  posts     BeautyTalkPost[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  // 계정 생성 정보 생성 및 수정 시간
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 약관 테이블
model Terms {
  id String @id @default(cuid())

  // 약관 동의 필드
  termsOfUse             Boolean @default(true)
  personalInfoRequired   Boolean @default(true)
  personalInfoOptional   Boolean @default(false)
  marketingOptional      Boolean @default(false)
  emailMarketing         Boolean @default(false)

  // User 모델 연결
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  // 동의 정보 생성 및 수정 시간
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 설문 조사 테이블
model Survey {
  id String @id @default(cuid())

  skinType String
  sensitiveSkin String
  skinConcerns String[]

  // User 모델 연결
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  // 설문 응답 생성 및 수정 시간
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 뷰티톡 게시글
model BeautyTalkPost {
  id        String   @id @default(cuid())

  title   String
  content String @db.Text
  type     PostType
  category PostCategory
  viewCount Int @default(0)
  likeCount Int @default(0)

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  images Image[]
  hashtags Hashtag[]
  comments Comment[]
  likes Like[]
  bookmarks Bookmark[]
}

// 게시글 이미지
model Image {
  id     String @id @default(cuid())
  url    String 
  
  post     BeautyTalkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
}

// 해시태그
model Hashtag {
  id    String   @id @default(cuid())
  name  String   @unique
  posts BeautyTalkPost[]
}

// 댓글
model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  post     BeautyTalkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
}

// 좋아요
model Like {
  id     String @id @default(cuid())
  
  post   BeautyTalkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId]) // 한 유저가 한 게시물에 한 번만 좋아요
}

// 북마크
model Bookmark {
  id     String @id @default(cuid())
  
  post   BeautyTalkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId]) // 한 유저가 한 게시물에 한 번만 북마크
}